+    bool finite = true;
+#if defined(__aarch64__)
+    const uint32x4_t zero = vdupq_n_u32(0);
+    const uint32x4_t mask = vdupq_n_u32(1023u);
+    uint32x4_t invalid = zero;
+    for (; i + 4 <= count; i += 4) {
