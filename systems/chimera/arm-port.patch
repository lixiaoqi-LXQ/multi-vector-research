+             << " cpu=" << sched_getcpu() << " allowed=";
+        bool first = true;
+        if (status == 0) for (int core = 0; core < CPU_SETSIZE; ++core) {
+            if (CPU_ISSET(core, &allowed)) {
+                if (!first) line << ',';
+                line << core;
+                first = false;
+            }
+        }
+        if (status != 0) line << "ERROR";
+#pragma omp critical
+        std::cout << line.str() << '\n';
+    }
 }
 
